<!-- tee-signer enclave configuration.
     HeapMaxSize 32 MiB: the largest request is a sealed blob (≤ 512 KiB) + a PSBT (≤ 256 KiB)
     + a header batch (≤ 160 KiB), with the response of the same order and the Rust allocator's
     working set on top; the number is a bound to be MEASURED in R2 against the worst-case PSBT
     the mandate allows (maxInputs/maxOutputs) and tightened. No EDMM on SGX1: the heap is
     committed at load and baked into MRENCLAVE.
     TCSNum 1, TCSPolicy 1 (unbound): one ecall at a time from ANY host thread. A bound policy
     (0) ties the single TCS to the first thread that entered and every other thread then gets
     SGX_ERROR_OUT_OF_TCS (0x1003) — found with the daemon's thread pool on hardware.
     DisableDebug is rewritten to 1 by the Makefile for RELEASE=1 builds; on the T1 box the launch
     is debug by hardware necessity and the binary reports tier T1-debug. -->
<EnclaveConfiguration>
  <ProdID>1</ProdID>
  <ISVSVN>1</ISVSVN>
  <StackMaxSize>0x100000</StackMaxSize>
  <HeapMaxSize>0x2000000</HeapMaxSize>
  <TCSNum>1</TCSNum>
  <TCSPolicy>1</TCSPolicy>
  <DisableDebug>0</DisableDebug>
  <MiscSelect>0</MiscSelect>
  <MiscMask>0xFFFFFFFF</MiscMask>
</EnclaveConfiguration>
