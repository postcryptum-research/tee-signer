# secrets and state — never committed (CLAUDE.md hard rule 7)
*.sealed
*.seed
*.mnemonic
*.key
*.pem
# the ceremony PUBLIC key is pinned in the tree: the Makefile's catsig and a fresh-clone rebuild need it (2026-11-21)
!enclave/ceremony/ceremony_pub.pem
*.auth
.env
.env.*
rpc-endpoints
recovery-blob*
owner-*.json
!owner-*.example.json
# local test wallets and keys (never committed)
.local/
# build output
target/
*.o
*.a
*.so
*.signed.so
build/
# fuzz (REQ-r10): crash artifacts are filed by hand into fuzz/findings or fuzz/regressions, never committed raw
fuzz/artifacts/
fuzz/coverage/
fuzz/fuzz-*.log
# editor / os
.vscode/
.idea/
*.swp
.DS_Store
# public CA certificates compiled into owner-cli (Intel SGX root, Yubico attestation root + intermediates); not secrets
!owner/owner-cli/src/intel_sgx_root_ca.pem
!owner/owner-cli/src/yubico-ca-1.pem
!owner/owner-cli/src/yubico-intermediate.pem
