@model UITeeSignerController.SendVm
@{
    ViewData["Title"] = "Send through the enclave";
    Layout = "_Layout";
}
<div class="row"><div class="col-xl-8">
<h2>Send through the TEE signer</h2>
<p class="text-secondary">The PSBT is built by NBXplorer from the cold wallet and judged inside the enclave against the mandate; a refusal names its reasons and charges nothing.</p>
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error @if (Model.Reasons.Count > 0) { <code>@string.Join(", ", Model.Reasons)</code> }</div> }
@if (Model.Result is not null) {
  <div class="alert alert-success">@Model.Result<br/>txid <code>@Model.Txid</code><br/>receipt seq @Model.Seq · session <code>@Model.SessionId</code><br/><small><code>@Model.ReceiptHex</code></small></div>
}
<form method="post">
  <input type="hidden" asp-for="StoreId" />
  <div class="form-group"><label asp-for="Destination" class="form-label">Destination</label><input asp-for="Destination" class="form-control" /></div>
  <div class="form-group"><label asp-for="AmountSats" class="form-label">Amount (sat)</label><input asp-for="AmountSats" class="form-control" type="number" min="546" /></div>
  <div class="form-group"><label asp-for="FeeRateSatVb" class="form-label">Fee rate (sat/vB)</label><input asp-for="FeeRateSatVb" class="form-control" type="number" step="0.1" min="1" /></div>
  <button type="submit" class="btn btn-primary">Judge and sign in the enclave</button>
</form>
<p class="mt-3"><a asp-action="Settings" asp-route-storeId="@Model.StoreId">Back to tee-signer settings</a></p>
</div></div>
