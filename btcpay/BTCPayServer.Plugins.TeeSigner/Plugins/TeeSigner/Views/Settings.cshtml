@model UITeeSignerController.SettingsVm
@{
    ViewData["Title"] = "tee-signer";
    Layout = "_Layout";
}
<partial name="_StatusMessage" />
<div class="row">
<div class="col-xl-8">
<h2>tee-signer — policy-bound SGX signer</h2>
<p class="text-secondary">The store wallet stays <strong>cold</strong> in BTCPay. This plugin only routes PSBTs to the signer daemon; the enclave decides, inside its owner-signed mandate.</p>

<form method="post">
  <input type="hidden" asp-for="StoreId" />
  <div class="form-group"><label asp-for="SignerdUrl" class="form-label">signerd URL</label><input asp-for="SignerdUrl" class="form-control" /></div>
  <div class="form-group"><label asp-for="Token" class="form-label">Bearer token (rate-limit credential, not an authorisation)</label><input asp-for="Token" class="form-control" type="password" /></div>
  <div class="form-group"><label asp-for="MinConfirmations" class="form-label">Minimum confirmations for coins to spend</label><input asp-for="MinConfirmations" class="form-control" type="number" min="0" /></div>
  <button type="submit" name="command" value="save" class="btn btn-primary">Save</button>
</form>

<h3 class="mt-4">Wallet</h3>
@if (!Model.WalletConfigured) {
  <div class="alert alert-warning">No BTC wallet on this store yet. Import the enclave's account key as a <strong>cold</strong> wallet: <code>[fingerprint/84'/coin'/0']xpub…</code></div>
} else if (Model.WalletIsHot) {
  <div class="alert alert-danger">The store wallet is <strong>HOT</strong> (seed in NBXplorer). tee-signer refuses to operate on it. Replace it with the enclave xpub imported as a cold wallet.</div>
} else {
  <p>Cold wallet: <code>@Model.WalletXpub</code></p>
}

<h3 class="mt-4">Enclave</h3>
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }
@if (Model.Status is not null) {
  <table class="table">
    <tr><th>enclave</th><td>@Model.Status.Enclave · tier <strong>@Model.Status.Tier</strong></td></tr>
    <tr><th>MRENCLAVE</th><td><code>@Model.Status.Mrenclave</code></td></tr>
    <tr><th>xpub</th><td><code>@Model.Status.Xpub</code> @if (Model.XpubMatches) { <span class="badge bg-success">matches the store wallet</span> } else { <span class="badge bg-danger">DOES NOT MATCH the store wallet</span> }</td></tr>
    <tr><th>mandate</th><td><code>@Model.Status.MandateHash</code> · nonce @Model.Status.Nonce · installed @Model.Status.Installed</td></tr>
    <tr><th>chain</th><td>best @Model.Status.BestHeight · @Model.Status.ClockLabel</td></tr>
    <tr><th>window</th><td>from @Model.Status.WindowStart · outflow @Model.Status.WindowOutflow sat · unlisted @Model.Status.WindowUnlisted sat · fees @Model.Status.WindowFees sat</td></tr>
    <tr><th>state</th><td>seq @Model.Status.Seq · frozen @Model.Status.Frozen · armed @Model.Status.Armed · chain frozen @Model.Status.ChainFrozen · session <code>@Model.Status.SessionId</code></td></tr>
  </table>
}

<h3 class="mt-4">Automated payouts</h3>
<form method="post">
  <input type="hidden" asp-for="StoreId" />
  @if (Model.ProcessorEnabled) {
    <p><span class="badge bg-success">TEE payout processor enabled</span></p>
    <button type="submit" name="command" value="disable-processor" class="btn btn-outline-danger">Disable</button>
  } else {
    <button type="submit" name="command" value="enable-processor" class="btn btn-outline-primary" @(Model.WalletIsHot || !Model.WalletConfigured ? "disabled" : "")>Enable TEE payout processor</button>
  }
</form>
<p class="mt-3"><a asp-action="Send" asp-route-storeId="@Model.StoreId">Send through the enclave</a></p>

<h3 class="mt-4">Receipts</h3>
<pre style="max-height:300px;overflow:auto">@Model.ReceiptsRaw</pre>
</div>
</div>
